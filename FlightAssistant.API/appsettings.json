{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Azure": {
    "SignUpSignInPolicyId": "B2C_1_signin_signup"
  },
  // AeroApi:Pricing lives HERE and not in Key Vault, unlike the rest of the AeroApi section:
  // Key Vault secret names are restricted to ^[0-9a-zA-Z-]+$, and these keys are endpoint
  // templates containing '/', '{' and '}', so they cannot be represented there at all.
  // Nothing secret is stored here either — these are published list prices, not credentials.
  "AeroApi": {
    // !! UNVERIFIED PLACEHOLDER PRICES !!
    // These per-call unit costs (USD) have NOT been confirmed against the actual FlightAware
    // AeroAPI plan this deployment is billed under. Until someone checks them against the plan
    // or a real invoice and updates them here, read GET /admin/usage/aeroapi as follows:
    //   - totalCalls / byTemplate[].calls / byOutcome[].calls  -> authoritative, measured.
    //   - estimatedSpendUsd / billableSpendUsd / currentMonthSpendUsd / share of budget
    //     -> indicative only; they are calls x these placeholder prices, nothing more.
    // Keys must match the AeroApiEndpointTemplate constants exactly; an unmatched key silently
    // prices at $0, which AeroApiPricingCoverageTests exists to catch.
    "Pricing": {
      "/schedules/{range}": 0.005,
      "/flights/{ident}": 0.005,
      "/airports/{id}": 0.005
    }
  },
  "FlightSync": {
    "Enabled": true,
    "Interval": "00:10:00",
    "NearDepartureInterval": "00:02:00"
  },
  "RateLimiting": {
    "FlightSearch": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    },
    "LoyaltyPrograms": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    }
  }
}
