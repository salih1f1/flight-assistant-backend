{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Azure": {
    "SignUpSignInPolicyId": "B2C_1_signin_signup"
  },
  "FlightSync": {
    "Enabled": true,
    "LoopInterval": "00:01:00",
    "Interval": "00:30:00",
    "NearDepartureInterval": "00:05:00",
    "ScheduleCheckInterval": "1.00:00:00",
    "FastWindowBeforeDeparture": "04:00:00",
    "StopAfterArrival": "00:30:00",
    "StopWithoutArrivalAfter": "1.00:00:00",
    "ManualSyncCooldown": "00:05:00"
  },
  "RateLimiting": {
    "FlightSearch": {
      "PermitLimit": 8,
      "WindowSeconds": 60
    },
    "LoyaltyPrograms": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    },
    "AdminReveal": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  }
}
