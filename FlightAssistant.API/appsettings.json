{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient.AviationStackFlightStatusProvider": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Azure": {
    "SignUpSignInPolicyId": "B2C_1_signin_signup"
  },
  "FlightSync": {
    "Enabled": true,
    "Interval": "00:10:00",
    "NearDepartureInterval": "00:02:00"
  },
  "RateLimiting": {
    "FlightSearch": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    },
    "LoyaltyPrograms": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    }
  }
}
