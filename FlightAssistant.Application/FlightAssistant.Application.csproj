<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageReference Include="MediatR" Version="13.0.0" />
    <!-- GetJobsQueryHandler/ToggleJobCommandHandler (#471) read FlightSync:Enabled/Verification:Enabled
         straight off IConfiguration, the same config ceiling the hosted services themselves read,
         rather than through an Application-side translation interface: CLAUDE.md already treats
         IConfiguration as a hosting artifact not worth wrapping for /admin/health, and the same
         reasoning applies here. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlightAssistant.Contracts\FlightAssistant.Contracts.csproj" />
    <ProjectReference Include="..\FlightAssistant.Domain\FlightAssistant.Domain.csproj" />
    <ProjectReference Include="..\FlightAssistant.SharedKernel\FlightAssistant.SharedKernel.csproj" />
  </ItemGroup>

</Project>
